# ─── Supabase (required) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Anthropic Claude (required) ──────────────────────────────────────────────
# Used by /api/analyze-room — RoomScan AI feature
ANTHROPIC_API_KEY=sk-ant-...

# ─── SerpAPI (optional) ────────────────────────────────────────────────────────
# Used by /api/search-furniture for product search fallback
# Get key at: https://serpapi.com
SERPAPI_KEY=your-serpapi-key

# ─── Unsplash (optional, legacy) ──────────────────────────────────────────────
# Only needed if you re-enable the /api/designs live feed
# Not required for production — app uses static mockDesigns
UNSPLASH_ACCESS_KEY=your-unsplash-key

# ─── Firebase (replaces Supabase Auth) ────────────────────────────────────────
# Create project at: https://console.firebase.google.com
# Enable Google sign-in: Authentication → Sign-in method → Google
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
